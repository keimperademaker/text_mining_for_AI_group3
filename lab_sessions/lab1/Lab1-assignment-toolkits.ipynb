    "# CONSTITUENCY PARSING WITH NLTK\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"CONSTITUENCY PARSING WITH NLTK\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Perform POS tagging for the tokens\n",
    "pos_tags = nltk.pos_tag(selected_tokens)\n",
    "print(\"\\nPOS Tags:\")\n",
    "print(pos_tags)\n",
    "\n",
    "# Use the constituency parser\n",
    "constituent_parser = nltk.RegexpParser('''\n",
    "NP: {<DT>? <JJ>* <NN.*>+} # Noun Phrase\n",
    "VP: {<V.*> <NP>*}          # Verb Phrase\n",
    "PP: {<IN> <NP>}            # Prepositional Phrase\n",
    "''')\n",
    "\n",
    "# Perform constituency parsing\n",
    "tree = constituent_parser.parse(pos_tags)\n",
    "print(\"\\nCONSTITUENCY TREE (NLTK):\")\n",
    "print(tree)\n",
    "print(\"\\nVisualizing the tree:\")\n",
    "tree.pretty_print()"
   ]
