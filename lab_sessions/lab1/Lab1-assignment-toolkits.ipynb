    "# DEPENDENCY PARSING WITH SPACY\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"DEPENDENCY PARSING WITH SPACY\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Get the corresponding sentence from spaCy\n",
    "selected_sentence_spacy = sents_spacy[sentence_idx]\n",
    "print(f\"\\nSentence: {selected_sentence_spacy}\")\n",
    "\n",
    "# Show dependencies for each token\n",
    "print(\"\\nDependencies (token -> head):\")\n",
    "for token in selected_sentence_spacy:\n",
    "    print(f\"{token.text:15} -> {token.head.text:15} ({token.dep_})\")\n",
    "\n",
    "# Visualize the dependency tree\n",
    "print(\"\\nVisualizing the dependency tree:\")\n",
    "from spacy import displacy\n",
    "displacy.render(selected_sentence_spacy, style='dep', jupyter=True)"
   ]
